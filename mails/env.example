# Email Service Environment Configuration
# Copy this file to .env and update with your values

# Application Configuration
NODE_ENV=development
PORT=3001

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Alternative SMTP Providers
# Gmail: smtp.gmail.com:587
# Outlook: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
# Custom SMTP: your-smtp-server.com:587

# Email Configuration
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Smart Skill Matrix
REPLY_TO_EMAIL=your_email@gmail.com

# Email Templates Configuration
TEMPLATE_ENGINE=handlebars
TEMPLATE_CACHE=true

# Email Queue Configuration
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_RETRY_ATTEMPTS=3
EMAIL_QUEUE_RETRY_DELAY=5000

# Email Rate Limiting
EMAIL_RATE_LIMIT_PER_MINUTE=60
EMAIL_RATE_LIMIT_PER_HOUR=1000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/email.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# Database Configuration (if using database for email queue)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smart_skill_matrix
# DB_USER=postgres
# DB_PASSWORD=admin

# Email Service Configuration
EMAIL_SERVICE_ENABLED=true
EMAIL_SERVICE_TIMEOUT=30000

# Notification Types Configuration
ENABLE_SKILL_REQUEST_NOTIFICATIONS=true
ENABLE_OBJECTIVE_NOTIFICATIONS=true
ENABLE_PROGRESS_UPDATE_NOTIFICATIONS=true
ENABLE_LATE_OBJECTIVE_NOTIFICATIONS=true
ENABLE_JOB_TITLE_OBJECTIVE_NOTIFICATIONS=true

# Email Content Configuration
EMAIL_SUBJECT_PREFIX=[Smart Skill Matrix]
EMAIL_SIGNATURE=Best regards,\nThe Smart Skill Matrix Team

# Security Configuration
EMAIL_ENCRYPTION=tls
EMAIL_AUTH_METHOD=login

# Monitoring Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=false

# Docker Configuration (for docker-compose)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Production Configuration (uncomment for production)
# NODE_ENV=production
# SMTP_SECURE=true
# LOG_LEVEL=warn
# EMAIL_RATE_LIMIT_PER_MINUTE=30
# EMAIL_RATE_LIMIT_PER_HOUR=500

# Gmail App Password Setup Instructions:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to Google Account settings > Security > App passwords
# 3. Generate an app password for "Mail"
# 4. Use the generated password as SMTP_PASS

# Other Email Providers:
# For Outlook/Hotmail: Use your regular password
# For Yahoo: Enable "Less secure app access" or use app password
# For custom SMTP: Use your server's credentials