# Backend Service Environment Configuration
# Copy this file to .env and update with your values

# Application Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_skill_matrix
DB_USER=postgres
DB_PASSWORD=admin
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email Service Configuration
EMAIL_SERVICE_URL=http://localhost:3001
EMAIL_SERVICE_ENABLED=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/backend.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Notification Configuration
NOTIFICATION_RETENTION_DAYS=30
LATE_OBJECTIVE_CHECK_INTERVAL=300000

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Docker Configuration (for docker-compose)
# DB_HOST=postgres
# EMAIL_SERVICE_URL=http://email-service:3001

# Production Configuration (uncomment for production)
# NODE_ENV=production
# DB_SSL=true
# LOG_LEVEL=warn
# CORS_ORIGIN=https://yourdomain.com