# Frontend Service Environment Configuration
# Copy this file to .env and update with your values

# API Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_EMAIL_SERVICE_URL=http://localhost:3001

# Application Configuration
REACT_APP_VERSION=1.4.0
REACT_APP_NAME=Smart Skill Matrix
REACT_APP_DESCRIPTION=A comprehensive skill management and objective tracking system

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_EMAIL_NOTIFICATIONS=true
REACT_APP_ENABLE_FILE_UPLOADS=true
REACT_APP_ENABLE_ANALYTICS=false

# UI Configuration
REACT_APP_THEME=light
REACT_APP_LANGUAGE=en
REACT_APP_TIMEZONE=UTC

# Authentication Configuration
REACT_APP_TOKEN_STORAGE_KEY=smart_skill_matrix_token
REACT_APP_REFRESH_TOKEN_STORAGE_KEY=smart_skill_matrix_refresh_token

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Notification Configuration
REACT_APP_NOTIFICATION_POLL_INTERVAL=30000
REACT_APP_NOTIFICATION_MAX_DISPLAY=10

# Development Configuration
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info

# Production Configuration (uncomment for production)
# REACT_APP_API_URL=https://api.yourdomain.com
# REACT_APP_EMAIL_SERVICE_URL=https://email.yourdomain.com
# REACT_APP_DEBUG=false
# REACT_APP_LOG_LEVEL=warn

# Docker Configuration (for docker-compose)
# REACT_APP_API_URL=http://backend:5000
# REACT_APP_EMAIL_SERVICE_URL=http://email-service:3001
