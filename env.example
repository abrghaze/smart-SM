# Smart Skill Matrix - Main Environment Configuration
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_skill_matrix
DB_USER=postgres
DB_PASSWORD=admin

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email Service Configuration
EMAIL_SERVICE_URL=http://localhost:3001

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_EMAIL_SERVICE_URL=http://localhost:3001
REACT_APP_VERSION=1.4.0

# Docker Configuration (for docker-compose)
POSTGRES_DB=smart_skill_matrix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Production Configuration (uncomment for production)
# NODE_ENV=production
# DB_HOST=postgres
# EMAIL_SERVICE_URL=http://email-service:3001
# CORS_ORIGIN=https://yourdomain.com
# REACT_APP_API_URL=https://api.yourdomain.com
# REACT_APP_EMAIL_SERVICE_URL=https://email.yourdomain.com
